#version 450
#include "common.glsl"
layout(local_size_x = 64) in;
layout(std430, binding = 1) readonly buffer Count { int cellCount[]; };
layout(std430, binding = 2) readonly buffer Flags { uint cellFlags[]; };
layout(std430, binding = 3) writeonly buffer Fill { uint fill[]; };
#ifdef MPM
layout(std430, binding = 4) readonly buffer Grid { vec4 grid[]; };
#else
layout(std430, binding = 4) readonly buffer Vel { float vel[]; };
layout(std430, binding = 5) readonly buffer Heat { int cellHeat[]; };
#endif
layout(push_constant) uniform PC { ivec4 a; ivec4 b; } pc;

bool fluidAt(ivec3 c) {
    return inBox(c) && (cellFlags[cellIndex(c)] & 0xFFu) == CELL_FLUID;
}

bool staticSolidAt(ivec3 c) {
    if (!inBox(c)) {
        return false;
    }
    uint f = cellFlags[cellIndex(c)];
    return (f & 0xFFu) == CELL_SOLID && (f >> 8) == 0u;
}

bool waterBeside(ivec3 c, ivec3 d, int res) {
    ivec3 far = c + d * (3 + res);
    return fluidAt(c + d * 3) && (fluidAt(far) || staticSolidAt(far));
}

float cellSpeed(ivec3 c) {
#ifdef MPM
    return length(grid[cellIndex(c)].xyz);
#else
    vec3 u = 0.5 * vec3(
        vel[faceIndex(0, c)] + vel[faceIndex(0, c + ivec3(1, 0, 0))],
        vel[faceIndex(1, c)] + vel[faceIndex(1, c + ivec3(0, 1, 0))],
        vel[faceIndex(2, c)] + vel[faceIndex(2, c + ivec3(0, 0, 1))]);
    return length(u);
#endif
}

void main() {
    int t = int(GID_U);
    ivec3 nb = pc.b.xyz;
    if (t >= nb.x * nb.y * nb.z) {
        return;
    }
    int res = int(G.camGrid.w);
    ivec3 block = pc.a.xyz + ivec3(t % nb.x, (t / nb.x) % nb.y, t / (nb.x * nb.y));
    float sum = 0.0;
    float speed = 0.0;
    float heat = 0.0;
    float particles = 0.0;
    for (int k = 0; k < res * res * res; k++) {
        ivec3 c = block * res + ivec3(k % res, (k / res) % res, k / (res * res));
        if (!inBox(c)) {
            continue;
        }
        int i = cellIndex(c);
        uint f = cellFlags[i];
        if ((f & 0xFFu) == CELL_SOLID && (f >> 8) != 0u) {
            if (waterBeside(c, ivec3(1, 0, 0), res) || waterBeside(c, ivec3(-1, 0, 0), res) || waterBeside(c, ivec3(0, 0, 1), res)
                || waterBeside(c, ivec3(0, 0, -1), res)) {
                sum += G.simA.y;
            }
        } else {
            sum += float(cellCount[i]);
            if ((f & 0xFFu) == CELL_FLUID) {
                speed = max(speed, cellSpeed(c));
            }
#ifndef MPM
            heat += float(cellHeat[i]);
            particles += float(cellCount[i]);
#endif
        }
    }
    uint full = uint(clamp(sum / (G.simA.y * float(res * res * res)), 0.0, 1.0) * 255.0 + 0.5);
    uint fast = uint(clamp(speed / float(res) * 16.0, 0.0, 255.0));
    uint temp = particles > 0.0 ? uint(clamp(heat / (particles * HEAT_FP), 0.0, 255.0) + 0.5) : 0u;
    fill[t] = full | (fast << 8) | (temp << 16);
}
