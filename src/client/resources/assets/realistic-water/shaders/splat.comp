#version 450
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer Parts { Particle parts[]; };
layout(std430, binding = 2) readonly buffer Counters { uint counters[]; };
layout(std430, binding = 3) buffer Accum { int accum[]; };
layout(push_constant) uniform PC { ivec4 a; ivec4 b; } pc;

void main() {
    uint i = GID_U;
    if (i >= counters[pc.a.x]) {
        return;
    }
    if (parts[i].pos.w < 0.0) {
        return;
    }
    vec3 g = parts[i].pos.xyz * float(G.fine.w) - 0.5;
    ivec3 b = ivec3(floor(g));
    vec3 f = g - vec3(b);
    for (int k = 0; k < 8; k++) {
        ivec3 o = ivec3(k & 1, (k >> 1) & 1, (k >> 2) & 1);
        ivec3 c = b + o;
        if (!inFine(c)) {
            continue;
        }
        vec3 w3 = mix(1.0 - f, f, vec3(o));
        atomicAdd(accum[fineIndex(c)], int(w3.x * w3.y * w3.z * 4096.0 + 0.5));
    }
}
