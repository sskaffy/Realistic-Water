#version 450
#include "common.glsl"
#define GRASS_PARAMS_BINDING 1
#define GRASS_BLOCKS_BINDING 2
#include "grass_common.glsl"
layout(local_size_x = 128) in;
layout(std430, binding = 3) readonly buffer State { vec4 st[]; };
layout(std430, binding = 4) writeonly buffer Verts { uint verts[]; };
layout(std430, binding = 5) buffer Count { uint quadCount; };

layout(push_constant) uniform PC {
    vec4 offset;
    ivec4 info;
} pc;

void writeVertex(uint v, vec3 pos, uint color, vec2 uv, uint light, vec3 normal, vec3 tangent) {
    uint o = v * uint(pc.info.x);
    verts[o] = floatBitsToUint(pos.x);
    verts[o + 1u] = floatBitsToUint(pos.y);
    verts[o + 2u] = floatBitsToUint(pos.z);
    verts[o + 3u] = color;
    verts[o + 4u] = floatBitsToUint(uv.x);
    verts[o + 5u] = floatBitsToUint(uv.y);
    verts[o + 6u] = 10u << 16;
    verts[o + 7u] = light;
    verts[o + 8u] = packSnorm4x8(vec4(normal, 0.0));
    if (pc.info.x >= 14) {
        verts[o + 9u] = 0u;
        verts[o + 10u] = 0u;
        verts[o + 11u] = floatBitsToUint(0.5);
        verts[o + 12u] = floatBitsToUint(0.5);
        verts[o + 13u] = packSnorm4x8(vec4(tangent, 1.0));
    }
}

vec3 saturate3(vec3 c, float s) {
    float l = dot(c, vec3(0.299, 0.587, 0.114));
    return max(mix(vec3(l), c, s), vec3(0.0));
}

vec3 albedoAt(float t, int type, vec3 tint, float shade, float press, float wilt) {
    bool cartoon = P.lod.z > 0.5;
    float variation = mix(0.82, 1.15, shade);
    vec3 albedo;
    if (grassDry(type)) {
        vec3 root = cartoon ? vec3(0.66, 0.47, 0.22) : vec3(0.52, 0.42, 0.26);
        vec3 tipC = cartoon ? vec3(0.98, 0.84, 0.45) : vec3(0.80, 0.70, 0.47);
        albedo = mix(root, tipC, smoothstep(0.0, 0.85, t)) * variation;
    } else if (cartoon) {
        vec3 lime = mix(vec3(0.40, 0.66, 0.13), vec3(0.66, 0.87, 0.22), smoothstep(0.0, 0.9, t));
        albedo = lime * mix(vec3(0.86, 1.0, 0.82), vec3(1.12, 1.02, 0.80), shade);
        albedo = mix(albedo, albedo * (tint / max(dot(tint, vec3(0.333)), 0.05)) * 0.55, 0.3);
    } else {
        albedo = tint * mix(0.46, 0.8, smoothstep(0.0, 0.9, t));
        albedo = mix(albedo, albedo * vec3(1.1, 1.05, 0.72), smoothstep(0.55, 1.0, t) * 0.45);
        albedo *= variation;
        if (shade < 0.07) {
            albedo = mix(albedo, vec3(0.55, 0.50, 0.30) * mix(0.5, 1.0, t), 0.45);
        }
    }
    albedo *= 1.0 - 0.1 * press;
    albedo = mix(albedo, vec3(0.62, 0.54, 0.34) * mix(0.7, 1.0, t), wilt * 0.85);
    albedo *= mix(cartoon ? 0.82 : 0.72, 1.0, smoothstep(0.0, 0.5, t));
    return clamp(albedo, 0.0, 1.0);
}

uint packColor(vec3 c) {
    uvec3 b = uvec3(round(clamp(c, 0.0, 1.0) * 255.0));
    return b.r | (b.g << 8) | (b.b << 16) | (255u << 24);
}

vec3 canopyNormal(vec3 n) {
    return normalize(mix(n, vec3(0.0, 1.0, 0.0), 0.6));
}

void main() {
    uint g = GID_U;
    if (pc.info.z == 1) {
        uint filled = min(quadCount, uint(pc.info.y));
        if (g < filled || g >= uint(pc.info.w)) {
            return;
        }
        for (uint k = 0u; k < 4u; k++) {
            uint o = (g * 4u + k) * uint(pc.info.x);
            verts[o] = 0u;
            verts[o + 1u] = 0u;
            verts[o + 2u] = 0u;
        }
        return;
    }
    int U = max(P.info.x, 1);
    int style = P.info.y;
    int slot = int(g) / U;
    int u = int(g) % U;
    if (slot >= P.cam.w || !grassActive(blocks[slot])) {
        return;
    }
    GrassBlock b = blocks[slot];
    GrassUnit n = grassUnit(slot, u);
    vec3 rel = pc.offset.xyz + n.root;
    float dist = length(rel);
    if (dist > P.lod.x + 4.0) {
        return;
    }
    uint lodSeed = n.seed ^ 0x9E3779B9u;
    if (style == 0 && dist > P.lod.y) {
        float keep = 1.0 - 0.6 * smoothstep(P.lod.y, P.lod.x, dist);
        if (rand(lodSeed) > keep) {
            return;
        }
    }
    uint sbase = g * uint(GRASS_STATE);
    vec3 nodes[GRASS_NODES + 1];
    bool fresh = floatBitsToUint(st[sbase + 8u].w) != grassGen(b);
    nodes[0] = fresh ? vec3(0.0) : st[sbase + 9u].xyz;
    float phase = fresh ? 0.0 : st[sbase].w;
    float lying = phase > 0.5 && phase < 1.5 ? st[sbase + 9u].w : 0.0;
    vec3 at = vec3(0.0);
    for (int i = 0; i < GRASS_NODES; i++) {
        at += grassRestDir(n, i, n.base) * (n.height / float(GRASS_NODES));
        nodes[i + 1] = fresh ? at : st[sbase + uint(i)].xyz;
    }
    vec3 setDir = fresh ? n.base : normalize(st[sbase + 8u].xyz + vec3(0.0, 1e-5, 0.0));
    float press = clamp(acos(clamp(dot(setDir, n.base), -1.0, 1.0)) / 1.4, 0.0, 1.0);
    float wilt = phase > 0.5 && phase < 1.5 ? clamp(0.25 + lying / max(P.life.x, 1.0), 0.0, 1.0) : 0.0;
    uint light = uint(floor(b.look.w / 16.0) * 16.0) | (uint(mod(b.look.w, 16.0) * 16.0) << 16);

    int blades = style == 1 ? CLUMP_BLADES : 1;
    int segments = style == 1 ? 2 : GRASS_NODES;
    uint quads = uint(blades * segments);
    uint base = atomicAdd(quadCount, quads);
    if (base + quads > uint(pc.info.y)) {
        return;
    }
    uint v = base * 4u;
    const float CT[4] = float[](0.0, 0.0, 1.0, 1.0);
    const float CS[4] = float[](-1.0, 1.0, 1.0, -1.0);
    for (int blade = 0; blade < blades; blade++) {
        vec3 root = n.root;
        float hs = 1.0;
        float yaw = n.yaw;
        vec3 off = vec3(0.0);
        uint bladeSeed = n.seed;
        if (style == 1) {
            bladeSeed = hash(n.seed + uint(blade) * 747796405u);
            uint s = bladeSeed;
            float a = rand(s) * 6.2831853;
            off = vec3(cos(a), 0.0, sin(a)) * 0.07 * sqrt(rand(s));
            hs = mix(0.7, 1.1, rand(s));
            yaw = rand(s) * 6.2831853;
        }
        uint shadeSeed = bladeSeed ^ 0x85EBCA6Bu;
        float shade = rand(shadeSeed);
        for (int seg = 0; seg < segments; seg++) {
            for (int k = 0; k < 4; k++) {
                float t = (float(seg) + CT[k]) / float(segments);
                float side = CS[k];
                vec3 p;
                vec3 tangent;
                chainAt(nodes, t, p, tangent);
                vec3 pos;
                vec3 normal;
                vec3 across;
                if (style == 2) {
                    across = vec3(cos(n.yaw), 0.0, sin(n.yaw));
                    pos = n.root + p + across * side * n.width;
                    normal = normalize(cross(across, tangent));
                } else {
                    p = p * hs + off * (1.0 + 1.5 * t);
                    across = vec3(-sin(yaw), 0.0, cos(yaw));
                    vec3 toCam = normalize(-(pc.offset.xyz + root + p));
                    vec3 facing = cross(tangent, toCam);
                    if (dot(facing, facing) > 1e-6) {
                        facing = normalize(facing);
                        across = normalize(mix(across, facing * sign(dot(facing, across) + 1e-4), 0.35));
                    }
                    across = normalize(across - tangent * dot(across, tangent) + vec3(1e-5, 0.0, 0.0));
                    float taper = P.lod.z > 0.5 ? cartoonLeaf(t) : 1.0 - pow(t, 1.35);
                    float w = n.width * taper * (1.0 + 0.6 * smoothstep(P.lod.y, P.lod.x, dist));
                    pos = root + p + across * side * w * 0.5;
                    normal = normalize(cross(across, tangent) + across * side * 0.45);
                }
                vec3 albedo = albedoAt(t, n.type, b.look.rgb, shade, press, wilt);
                writeVertex(v, pc.offset.xyz + pos, packColor(albedo), vec2(side * 0.5 + 0.5, 1.0 - t), light, canopyNormal(normal), across);
                v++;
            }
        }
    }
}
