bool solidAt(vec3 p) {
    ivec3 c = ivec3(floor(p));
    return inGrid(c) && staticSolid[cellIndex(c)] != 0u;
}

int countAt(ivec3 c) {
    return inBox(c) ? cellCount[cellIndex(c)] : 0;
}

bool waterFilm(vec3 x, inout vec3 v, inout vec3 dx, inout float dryness) {
    ivec3 c = ivec3(floor(x));
    int n27 = 0;
    int column = 0;
    for (int k = 0; k < 27; k++) {
        ivec3 o = ivec3(k % 3, (k / 3) % 3, k / 9) - 1;
        int n = countAt(c + o);
        n27 += n;
        column += o.y >= 0 ? n : 0;
    }
    if (solidAt(x - vec3(0.0, 1.0, 0.0))) {
        float depth = float(column) / (9.0 * G.simA.y);
        float thin = clamp(1.0 - depth / max(G.matB.w, 1e-3), 0.0, 1.0);
        float speed = length(v.xz);
        bool groundAhead = speed < 1e-3 || solidAt(x + vec3(v.x / speed, -1.0, v.z / speed));
        if (thin > 0.0 && groundAhead) {
            float damp = exp(-G.matB.x * thin * DT);
            v.xz *= damp;
            dx.xz *= damp;
        }
    }
    float res = G.camGrid.w;
    if (n27 < int(G.matB.z) && length(v) < 1.5 * res) {
        dryness += DT / max(G.matB.y, 1e-3);
    } else {
        dryness = 0.0;
    }
    return dryness < 1.0;
}

void slimeAdhere(vec3 x, inout vec3 v, inout vec3 dx) {
    const vec3 SIDES[6] = vec3[](vec3(0.6, 0.0, 0.0), vec3(-0.6, 0.0, 0.0), vec3(0.0, 0.6, 0.0), vec3(0.0, -0.6, 0.0), vec3(0.0, 0.0, 0.6),
        vec3(0.0, 0.0, -0.6));
    for (int k = 0; k < 6; k++) {
        if (solidAt(x + SIDES[k])) {
            float damp = exp(-G.matA.y * DT);
            v *= damp;
            dx *= damp;
            return;
        }
    }
}

bool slimeSupported(vec3 x) {
    ivec3 c = ivec3(floor(x));
    for (int k = 1; k <= 32; k++) {
        ivec3 b = c - ivec3(0, k, 0);
        if (!inGrid(b)) {
            return false;
        }
        if (staticSolid[cellIndex(b)] != 0u) {
            return true;
        }
        if (countAt(b) == 0) {
            return false;
        }
    }
    return true;
}

vec3 escapeSolid(vec3 x, inout vec3 v) {
    ivec3 c = ivec3(floor(x));
    vec3 f = x - vec3(c);
    const ivec3 OUT[6] = ivec3[](ivec3(0, 1, 0), ivec3(1, 0, 0), ivec3(-1, 0, 0), ivec3(0, 0, 1), ivec3(0, 0, -1), ivec3(0, -1, 0));
    float best = 9.0;
    int pick = -1;
    for (int k = 0; k < 6; k++) {
        ivec3 nc = c + OUT[k];
        if (inGrid(nc) && staticSolid[cellIndex(nc)] != 0u) {
            continue;
        }
        int a = OUT[k].x != 0 ? 0 : OUT[k].y != 0 ? 1 : 2;
        float d = OUT[k][a] > 0 ? 1.0 - f[a] : f[a];
        if (d < best - 0.02) {
            best = d;
            pick = k;
        }
    }
    if (pick < 0) {
        return x;
    }
    vec3 n = vec3(OUT[pick]);
    int a = OUT[pick].x != 0 ? 0 : OUT[pick].y != 0 ? 1 : 2;
    vec3 r = x;
    r[a] = n[a] > 0.0 ? float(c[a] + 1) + 0.05 : float(c[a]) - 0.05;
    float vn = dot(v, n);
    if (vn < 0.0) {
        v -= n * vn;
    }
    return r;
}

vec3 collideStatic(vec3 x, vec3 xn, inout vec3 v) {
    if (solidAt(x)) {
        return escapeSolid(x, v);
    }
    vec3 d = xn - x;
    float m = max(abs(d.x), max(abs(d.y), abs(d.z)));
    int n = clamp(int(ceil(m / 0.45)), 1, 32);
    vec3 stepD = d / float(n);
    vec3 r = x;
    const int ORDER[3] = int[](1, 0, 2);
    for (int s = 0; s < n; s++) {
        vec3 goal = r + stepD;
        for (int k = 0; k < 3; k++) {
            int a = ORDER[k];
            if (stepD[a] == 0.0) {
                continue;
            }
            vec3 t = r;
            t[a] = goal[a];
            if (!solidAt(t)) {
                r = t;
            } else {
                t[a] = stepD[a] > 0.0 ? floor(r[a]) + 0.999 : floor(r[a]) + 0.001;
                if (!solidAt(t)) {
                    r = t;
                }
                v[a] = 0.0;
                stepD[a] = 0.0;
            }
        }
    }
    return r;
}

vec3 vesselVel(int e, vec3 p) {
    return G.ent[e * 3 + 1].xyz + cross(G.ent[e * 3 + 4].xyz, p - G.ent[e * 3].xyz);
}

bool vesselCollide(int e, vec3 x, vec3 v, out vec3 surface, out vec3 normal) {
    surface = x;
    normal = vec3(0.0, 1.0, 0.0);
    Vessel s = vesselOf(e);
    vec4 inv = vec4(-s.q.xyz, s.q.w);
    vec3 l = quatRotate(inv, x - s.c);
    if (!vesselSolid(s, l, 0.0)) {
        return false;
    }
    vec3 back = quatRotate(inv, (v - vesselVel(e, x)) * DT * 2.0);
    vec3 prev = l - back;
    bool cavity;
    if (vesselInCavity(s, prev)) {
        cavity = true;
    } else if (any(greaterThan(abs(prev), s.h))) {
        cavity = false;
    } else {
        cavity = vesselPrefersCavity(s, l);
    }
    vec3 lp;
    vec3 ln;
    if (!vesselExit(s, l, 0.0, cavity, lp, ln)) {
        return false;
    }
    surface = s.c + quatRotate(s.q, lp);
    normal = quatRotate(s.q, ln);
    return true;
}

vec3 collideEntities(vec3 x, inout vec3 v) {
    for (int e = 0; e < numEntities(); e++) {
        vec3 s;
        vec3 n;
        bool vessel = entIsContainer(e);
        if (vessel ? !vesselCollide(e, x, v, s, n) : !entInside(e, x, 0.0, s, n)) {
            continue;
        }
        vec3 ve = vessel ? vesselVel(e, s) : entVel(e);
        x = s;
        float vn = dot(v, n);
        float en = dot(ve, n);
        if (vn < en) {
            v += n * (en - vn);
        }
        if (isSlime()) {
            v = mix(v, ve, G.matA.z);
        }
    }
    return x;
}

bool drainWater(vec3 x) {
    if (!isWater()) {
        return false;
    }
    for (int e = 0; e < numEntities(); e++) {
        if (entIsDrain(e) && all(greaterThanEqual(x, entMin(e))) && all(lessThan(x, entMax(e)))) {
            return true;
        }
    }
    return false;
}

float intakeFill(vec3 lo, vec3 hi) {
    int wet = 0;
    for (int k = 0; k < 27; k++) {
        vec3 f = (vec3(k % 3, (k / 3) % 3, k / 9) + 0.5) / 3.0;
        if (countAt(ivec3(floor(mix(lo, hi, f)))) > 0) {
            wet++;
        }
    }
    return float(wet) / 27.0;
}

vec3 pumpWater(vec3 x, inout vec3 v, inout uint seed) {
    for (int e = 0; e < numEntities(); e++) {
        if (!entIsPump(e)) {
            continue;
        }
        vec3 lo = G.ent[e * 3].xyz;
        vec3 hi = G.ent[e * 3 + 1].xyz;
        vec3 shift = G.ent[e * 3 + 2].xyz;
        vec3 dir = normalize(shift);
        float speed = G.ent[e * 3 + 1].w;
        vec3 back = -dir * (hi.x - lo.x);
        vec3 pullLo = min(lo, lo + back);
        vec3 pullHi = max(hi, hi + back);
        if (any(lessThan(x, pullLo)) || any(greaterThan(x, pullHi))) {
            continue;
        }
        float along = dot(v, dir);
        if (along < 0.5 * speed) {
            v += dir * min(0.5 * speed - along, 3.0 * speed * DT);
        }
        if (any(lessThan(x, lo)) || any(greaterThan(x, hi))) {
            return x;
        }
        float chance = G.ent[e * 3].w * DT / max(intakeFill(lo, hi), 0.08);
        if (rand(seed) < chance && !solidAt(x + shift)) {
            x += shift;
            v = dir * speed + (v - dir * dot(v, dir)) * 0.3;
        }
        return x;
    }
    return x;
}

#define THERMAL_SHIFT 20u
#define VANILLA_SINK 0x40000000u
#define LATENT_HEAT 539.2

uint lightWordAt(vec3 x) {
    int res = max(int(G.camGrid.w + 0.5), 1);
    ivec3 n = max(G.dims.xyz / res, ivec3(1));
    ivec3 b = ivec3(floor(x / float(res)));
    if (any(lessThan(b, ivec3(0))) || any(greaterThanEqual(b, n))) {
        return 0u;
    }
    return regionLight[b.x + n.x * (b.y + n.y * b.z)];
}

uint thermalAt(vec3 x) {
    return (lightWordAt(x) >> THERMAL_SHIFT) & 7u;
}

#define MAX_MAGMA_REACH 8

void heatEvent(vec3 x, float kind) {
    uint o = atomicAdd(eventCount, 1u);
    if (o < uint(pc.b.z)) {
        events[o] = vec4(x, kind);
    }
}

float expansion(float t) {
    const float T[7] = float[](0.0, 4.0, 20.0, 40.0, 60.0, 80.0, 100.0);
    const float B[7] = float[](-6.8e-5, 0.0, 2.07e-4, 3.85e-4, 5.23e-4, 6.43e-4, 7.52e-4);
    if (t <= T[0]) {
        return B[0];
    }
    for (int i = 1; i < 7; i++) {
        if (t <= T[i]) {
            return mix(B[i - 1], B[i], (t - T[i - 1]) / (T[i] - T[i - 1]));
        }
    }
    return B[6];
}

bool stepHeat(vec3 x, inout vec3 v, inout float temp, inout uint seed, out bool heated) {
    heated = false;
    float res = G.camGrid.w;
    ivec3 c = ivec3(floor(x));
    int sumHeat = 0;
    int sumCount = 0;
    for (int k = 0; k < 27; k++) {
        ivec3 q = c + ivec3(k % 3, (k / 3) % 3, k / 9) - 1;
        if (inBox(q)) {
            int i = cellIndex(q);
            sumHeat += cellHeat[i];
            sumCount += cellCount[i];
        }
    }
    float around = temp;
    if (sumCount > 0) {
        around = float(sumHeat) / (float(sumCount) * HEAT_FP);
        temp += (around - temp) * (1.0 - exp(-G.heatA.z * DT));
    }
    float perFlux = G.heatA.w * DT;
    float magmaTarget = -1.0;
    bool lava = false;
    for (int k = 1; k < 7; k++) {
        vec3 o = vec3(0.0);
        o[(k - 1) >> 1] = (k & 1) == 1 ? 1.0 : -1.0;
        uint code = thermalAt(x + o);
        if (code == 1u) {
            magmaTarget = G.heatC.x;
        } else if (code == 2u) {
            lava = true;
        } else if (code == 3u || code == 4u || code == 7u) {
            float target = code == 3u ? G.heatC.z : code == 4u ? G.heatC.w : G.heatF.x;
            float rate = code == 3u ? G.heatE.z : code == 4u ? G.heatE.w : G.heatF.y;
            if (temp < target) {
                temp += (target - temp) * (1.0 - exp(-rate * DT));
            }
            heated = true;
        } else if (code >= 5u && temp > 0.0) {
            temp = max(temp - G.heatB.y * temp * perFlux, 0.0);
        }
    }
    // Fire radiates: flames on an edge or corner of the particle's block heat it too, not just ones on a face.
    for (int k = 0; k < 27; k++) {
        ivec3 d3 = ivec3(k % 3, (k / 3) % 3, k / 9) - 1;
        if (abs(d3.x) + abs(d3.y) + abs(d3.z) < 2) {
            continue;
        }
        if (thermalAt(x + vec3(d3)) == 3u) {
            float target = G.heatC.z;
            if (temp < target) {
                temp += (target - temp) * (1.0 - exp(-G.heatE.z * 0.6 * DT));
            }
            heated = true;
        }
    }
    if (magmaTarget < 0.0 && G.heatC.y > 0.0) {
        int reach = min(int(ceil(G.heatC.y)), MAX_MAGMA_REACH);
        for (int d = 1; d <= reach; d++) {
            uint word = lightWordAt(x - vec3(0.0, float(d) * res, 0.0));
            if (((word >> THERMAL_SHIFT) & 7u) == 1u) {
                float fade = clamp(1.0 - float(d - 1) / G.heatC.y, 0.0, 1.0);
                magmaTarget = mix(G.heatA.y, G.heatC.x, fade);
                break;
            }
            if ((word & 0x100u) != 0u) {
                break;
            }
        }
    }
    if (magmaTarget >= 0.0) {
        if (temp < magmaTarget) {
            temp += (magmaTarget - temp) * (1.0 - exp(-G.heatE.x * DT));
        }
        heated = true;
    }
    if (lava) {
        heated = true;
        temp = max(temp, 100.0);
        if (rand(seed) < 1.0 - exp(-G.heatE.y * DT)) {
            return false;
        }
    }
    if (countAt(c + ivec3(0, 1, 0)) == 0) {
        float ambient = G.heatA.y;
        float t = temp * 0.01;
        float ta = ambient * 0.01;
        float q = G.heatB.x * (temp - ambient) + 6000.0 * max(t * t * t - ta * ta * ta, 0.0);
        temp = max(temp - q * perFlux, min(temp, ambient));
    }
    float liquidT = max(temp, 0.0);
    v.y += -G.gravityDt.y * expansion(liquidT) * (liquidT - max(around, 0.0)) * DT;
    temp = max(temp, G.freezeA.z > 0.0 ? -2.0 * G.freezeA.z : 0.0);
    if (temp > 100.0) {
        float excess = temp - 100.0;
        temp = 100.0;
        vec3 kick = vec3(rand(seed) - 0.5, rand(seed), rand(seed) - 0.5);
        v += kick * G.heatB.z * DT;
        if (rand(seed) < excess / LATENT_HEAT) {
            return false;
        }
    }
    if (temp > G.heatB.w && countAt(c + ivec3(0, 1, 0)) == 0
        && rand(seed) < 0.05 * (temp - G.heatB.w) / max(100.0 - G.heatB.w, 1.0) * DT) {
        heatEvent(x, 1.0);
    }
    return true;
}

void spawnBubble(vec3 x, vec3 v, float kind, float size, inout uint seed) {
    if (pc.b.y == 0) {
        return;
    }
    uint o = atomicAdd(counters[pc.b.x], 1u);
    if (o < uint(G.caps.y)) {
        float life = kind >= WW_CLING ? 1.5 + 3.0 * rand(seed) : 8.0;
        wwDst[o] = Particle(vec4(x, life), vec4(v, kind + clamp(size, 0.02, 0.999)));
    }
}

void boilBubbles(vec3 x, inout vec3 v, float temp, bool heated, inout uint seed) {
    if (heated && temp >= 85.0 && temp < 99.5 && rand(seed) < 0.05 * DT) {
        heatEvent(x, 2.0);
    }
    if (heated && temp >= G.heatD.w && temp < 99.0 && rand(seed) < 0.06 * DT) {
        spawnBubble(x, vec3(0.0), WW_CLING, 0.08 + 0.15 * rand(seed), seed);
    }
    if (heated && temp >= 96.0) {
        uint site = hash(uint(worldCell(x).x) * 73856093u ^ uint(worldCell(x).y) * 19349663u ^ uint(worldCell(x).z) * 83492791u);
        float strength = clamp((temp - 96.0) / 4.0, 0.0, 1.0);
        if ((site & 15u) == 0u && rand(seed) < G.heatD.z / G.simA.y * strength * DT) {
            spawnBubble(x, vec3(0.0, 0.3 * G.heatD.y * G.camGrid.w, 0.0), WW_VAPOUR, 0.25 + 0.5 * strength * rand(seed), seed);
        }
    }
    if (temp >= 99.5 && countAt(ivec3(floor(x)) + ivec3(0, 1, 0)) == 0 && rand(seed) < 2.0 * DT) {
        v.y += 0.08 * G.heatB.z * rand(seed);
    }
}

void emitWhitewater(uint id, vec3 x, vec3 v) {
    ivec3 c = ivec3(floor(x));
    if (!inBox(c)) {
        return;
    }
    vec2 pot = potential[cellIndex(c)];
    float speed = length(v) * CELL_H;
    float energy = 0.5 * speed * speed;
    float iTA = clampPhi(pot.x, G.wwB.x, G.wwB.y);
    float iWC = clampPhi(pot.y * CELL_H, G.wwB.z, G.wwB.w);
    float iK = clampPhi(energy, G.wwA.z, G.wwA.w);
    float amount = iK * (G.wwA.x * iTA + G.wwA.y * iWC) * DT;
    amount *= max(0.0, 1.0 - float(wwCount[cellIndex(c)]) / float(max(G.flags.w, 1)));
    if (amount <= 0.0) {
        return;
    }
    uint seed = hash(id * 1664525u + uint(pc.a.w));
    int count = int(amount) + (rand(seed) < fract(amount) ? 1 : 0);
    count = min(count, int(G.wwD.w));
    for (int k = 0; k < count; k++) {
        uint o = atomicAdd(counters[pc.b.x], 1u);
        if (o >= uint(G.caps.y)) {
            return;
        }
        vec3 offset = randInSphere(seed) * 0.6;
        float life = mix(G.wwC.x, G.wwC.y, rand(seed));
        vec3 jitter = randInSphere(seed) * 0.15 * length(v);
        wwDst[o] = Particle(vec4(x + offset, life), vec4(v + jitter, 1.0));
    }
}

bool oceanRelax(vec3 x, inout vec3 v, inout vec3 dx, inout uint seed, out float deviation) {
    deviation = 0.0;
    float surface;
    vec3 target;
    if (!oceanTarget(x, surface, target) || insideVesselCavity(x)) {
        return true;
    }
    float res = G.camGrid.w;
    vec3 off = (v - target) / res;
    deviation = min(dot(off, off), 16.0);
    float w = oceanBand(x);
    float a = 1.0 - exp(-(G.oceanB.w * w + G.oceanC.w) * DT);
    v = mix(v, target, a);
    dx = mix(dx, target * DT, a);
    return w <= 0.0 || !(x.y > surface + 0.5 && rand(seed) < w * G.oceanC.z * DT);
}

void main() {
    uint i = GID_U;
    if (i >= counters[pc.a.x]) {
        return;
    }
    Particle p = src[i];
    if (p.pos.w < 0.0) {
        return;
    }
    vec3 x = p.pos.xyz;
    vec3 v = p.vel.xyz;
    float tag = p.pos.w;
    float rest = 0.0;
    float temp = p.vel.w;
    bool freezing = heatOn() && G.freezeA.z > 0.0;
    if (freezing && G.freezeA.x > 0.5) {
        temp = G.freezeA.y;
    }
    bool wasIce = freezing && solidIce(temp);
    if (!wasIce && drainWater(x)) {
        return;
    }
    float maxSpeed = G.simB.x;
    bool gridded = inInnerBox(x);
    vec3 dx;
    if (gridded) {
        vec3 uNew = sampleVel(x);
        vec3 uOld = sampleVelOld(x);
        v = mix(uNew, v + (uNew - uOld), G.simA.x);
        dx = DT * sampleVel(x + 0.5 * DT * uNew);
        if (!wasIce && !waterFilm(x, v, dx, tag)) {
            return;
        }
        if (heatOn()) {
            uint heatSeed = hash(i * 2246822519u + uint(pc.a.w) * 3266489917u);
            bool heated;
            bool kept = stepHeat(x, v, temp, heatSeed, heated);
            uint groupHeated = subgroupAdd(heated ? 1u : 0u);
            float groupHot = subgroupMax(temp);
            if (subgroupElect()) {
                atomicAdd(counters[5], groupHeated);
                atomicMax(counters[15], floatBitsToUint(groupHot));
            }
            if (!kept) {
                heatEvent(x, 0.0);
                spawnBubble(x, v * 0.3, WW_VAPOUR, 0.35 + 0.4 * rand(heatSeed), heatSeed);
                return;
            }
            boilBubbles(x, v, temp, heated, heatSeed);
        }
        if (freezing && solidIce(temp)) {
            v = vec3(0.0);
            dx = vec3(0.0);
        } else if (freezing && temp < 0.0) {
            float f = iceFraction(temp);
            v = mix(v, uNew, f);
            ivec3 cb = ivec3(floor(x)) - ivec3(0, 1, 0);
            bool held = solidAt(x - vec3(0.0, 1.0, 0.0)) || countAt(cb) > 0;
            if (held) {
                float damp = exp(-G.freezeA.w * f * DT);
                v.xz *= damp;
                float res = G.camGrid.w;
                if (f > 0.6 && length(v) < 0.25 * res) {
                    v.xz = vec2(0.0);
                }
            }
            dx = mix(dx, v * DT, f);
        }
        if (oceanOn() && !(freezing && solidIce(temp))) {
            uint oceanSeed = hash(i * 3266489917u + uint(pc.a.w) * 668265263u);
            float deviation;
            bool keep = oceanRelax(x, v, dx, oceanSeed, deviation);
            uint groupDeviation = subgroupAdd(uint(deviation * 64.0));
            if (subgroupElect()) {
                atomicAdd(counters[7], groupDeviation);
            }
            if (!keep) {
                return;
            }
        }
        bool squeezed = isSlime() && float(countAt(ivec3(floor(x)))) > G.simA.y * 1.5;
        if (isSlime() && squeezed) {
            rest = 0.0;
        } else if (isSlime()) {
            slimeAdhere(x, v, dx);
            rest = p.vel.w;
            bool frozen = rest >= G.matC.y;
            bool holding = frozen ? length(uNew) <= G.matC.z : length(v) < G.matC.x;
            rest = holding && slimeSupported(x) ? rest + DT : 0.0;
            if (rest >= G.matC.y) {
                rest = G.matC.y;
                v = vec3(0.0);
                dx = vec3(0.0);
            }
        }
    } else {
        v += G.gravityDt.xyz * DT;
        dx = DT * v;
    }
    float s = length(v);
    if (s > maxSpeed) {
        v *= maxSpeed / s;
    }
    float dl = length(dx);
    float maxStep = maxSpeed * DT;
    if (dl > maxStep) {
        dx *= maxStep / dl;
    }
    vec3 xn = collideStatic(x, x + dx, v);
    bool iceNow = freezing && solidIce(temp);
    if (iceNow) {
        v = vec3(0.0);
        xn = x;
    } else {
        xn = collideEntities(xn, v);
        uint pumpSeed = hash(i * 2654435761u + uint(pc.a.w) * 40503u);
        xn = pumpWater(xn, v, pumpSeed);
        if (drainWater(xn)) {
            return;
        }
    }
    if (any(isnan(xn)) || any(isinf(xn)) || any(isnan(v))) {
        return;
    }

    float killMargin = G.killInfo.y;
    if (any(lessThan(xn, vec3(-killMargin))) || any(greaterThanEqual(xn, vec3(NX, NY, NZ) + killMargin)) || xn.y < G.killInfo.x) {
        return;
    }
    if (oceanOn() && (xn.x < G.oceanA.y || xn.x >= G.oceanB.y || xn.z < G.oceanA.z || xn.z >= G.oceanB.z)) {
        return;
    }
    if ((lightWordAt(xn) & VANILLA_SINK) != 0u && !insideVesselCavity(xn)) {
        return;
    }
    uint groupTotal = subgroupAdd(1u);
    uint prefix = subgroupExclusiveAdd(1u);
    float groupMax = subgroupMax(length(v));
    REPORT_DIR_SPEED(v)
    uint base = 0u;
    if (subgroupElect()) {
        base = atomicAdd(counters[pc.a.y], groupTotal);
        atomicMax(counters[6], floatBitsToUint(groupMax));
    }
    uint o = subgroupBroadcastFirst(base) + prefix;
    if (o >= uint(G.caps.x)) {
        return;
    }
    dst[o] = Particle(vec4(xn, tag), vec4(v, isWater() ? temp : rest));
    uvec3 cell = uvec3(ivec3(floor(xn)) + AABB_BIAS);
    uvec3 lo = uvec3(subgroupMin(cell.x), subgroupMin(cell.y), subgroupMin(cell.z));
    uvec3 hi = uvec3(subgroupMax(cell.x), subgroupMax(cell.y), subgroupMax(cell.z));
    if (subgroupElect()) {
        atomicMin(counters[8], lo.x);
        atomicMin(counters[9], lo.y);
        atomicMin(counters[10], lo.z);
        atomicMax(counters[11], hi.x);
        atomicMax(counters[12], hi.y);
        atomicMax(counters[13], hi.z);
    }
    if (pc.b.y != 0 && gridded) {
        emitWhitewater(i, xn, v);
    }
}
