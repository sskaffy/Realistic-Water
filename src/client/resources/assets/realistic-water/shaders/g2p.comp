#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#define WITH_VEL_OLD
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer Src { Particle src[]; };
layout(std430, binding = 2) writeonly buffer Dst { Particle dst[]; };
layout(std430, binding = 3) buffer Counters { uint counters[]; };
layout(std430, binding = 4) readonly buffer Vel { float vel[]; };
layout(std430, binding = 5) readonly buffer VelOld { float velOld[]; };
layout(std430, binding = 6) readonly buffer Flags { uint cellFlags[]; };
layout(std430, binding = 7) readonly buffer Static { uint staticSolid[]; };
layout(std430, binding = 8) readonly buffer Pot { vec2 potential[]; };
layout(std430, binding = 9) writeonly buffer WwDst { Particle wwDst[]; };
layout(std430, binding = 10) readonly buffer WwCount { int wwCount[]; };
layout(std430, binding = 11) readonly buffer Count { int cellCount[]; };
layout(push_constant) uniform PC { ivec4 a; ivec4 b; } pc;

#include "gridsample.glsl"

bool solidAt(vec3 p) {
    ivec3 c = ivec3(floor(p));
    return inGrid(c) && staticSolid[cellIndex(c)] != 0u;
}

int countAt(ivec3 c) {
    return inBox(c) ? cellCount[cellIndex(c)] : 0;
}

bool waterFilm(vec3 x, inout vec3 v, inout vec3 dx, inout float dryness) {
    ivec3 c = ivec3(floor(x));
    int n27 = 0;
    int column = 0;
    for (int k = 0; k < 27; k++) {
        ivec3 o = ivec3(k % 3, (k / 3) % 3, k / 9) - 1;
        int n = countAt(c + o);
        n27 += n;
        column += o.y >= 0 ? n : 0;
    }
    if (solidAt(x - vec3(0.0, 1.0, 0.0))) {
        float depth = float(column) / (9.0 * G.simA.y);
        float thin = clamp(1.0 - depth / max(G.matB.w, 1e-3), 0.0, 1.0);
        float speed = length(v.xz);
        bool groundAhead = speed < 1e-3 || solidAt(x + vec3(v.x / speed, -1.0, v.z / speed));
        if (thin > 0.0 && groundAhead) {
            float damp = exp(-G.matB.x * thin * DT);
            v.xz *= damp;
            dx.xz *= damp;
        }
    }
    float res = G.camGrid.w;
    if (n27 < int(G.matB.z) && length(v) < 1.5 * res) {
        dryness += DT / max(G.matB.y, 1e-3);
    } else {
        dryness = 0.0;
    }
    return dryness < 1.0;
}


vec3 collideStatic(vec3 x, vec3 xn, inout vec3 v) {
    if (solidAt(x)) {
        ivec3 c = ivec3(floor(x));
        const ivec3 OUT[6] = ivec3[](ivec3(0, 1, 0), ivec3(1, 0, 0), ivec3(-1, 0, 0), ivec3(0, 0, 1), ivec3(0, 0, -1), ivec3(0, -1, 0));
        for (int k = 0; k < 6; k++) {
            ivec3 nc = c + OUT[k];
            if (!inGrid(nc) || staticSolid[cellIndex(nc)] == 0u) {
                v = vec3(OUT[k]) * 2.0;
                return vec3(nc) + 0.5;
            }
        }
        return x;
    }
    vec3 r = x;
    const int ORDER[3] = int[](1, 0, 2);
    for (int k = 0; k < 3; k++) {
        int a = ORDER[k];
        vec3 t = r;
        t[a] = xn[a];
        if (!solidAt(t)) {
            r = t;
        } else {
            float edge = xn[a] > r[a] ? floor(r[a]) + 0.999 : floor(r[a]) + 0.001;
            t[a] = edge;
            if (!solidAt(t)) {
                r = t;
            }
            v[a] = 0.0;
        }
    }
    return r;
}

vec3 collideEntities(vec3 x, inout vec3 v) {
    for (int e = 0; e < numEntities(); e++) {
        vec3 lo = entMin(e);
        vec3 hi = entMax(e);
        if (any(lessThan(x, lo)) || any(greaterThan(x, hi))) {
            continue;
        }
        vec3 dLo = x - lo;
        vec3 dHi = hi - x;
        vec3 ve = entVel(e);
        int axis = 0;
        float best = 1e9;
        float dir = 1.0;
        for (int a = 0; a < 3; a++) {
            if (dLo[a] < best) { best = dLo[a]; axis = a; dir = -1.0; }
            if (dHi[a] < best) { best = dHi[a]; axis = a; dir = 1.0; }
        }
        x[axis] = dir > 0.0 ? hi[axis] + 0.01 : lo[axis] - 0.01;
        v[axis] = dir * max(dir * v[axis], dir * ve[axis]);
    }
    return x;
}

void emitWhitewater(uint id, vec3 x, vec3 v) {
    ivec3 c = ivec3(floor(x));
    if (!inBox(c)) {
        return;
    }
    vec2 pot = potential[cellIndex(c)];
    float speed = length(v) * CELL_H;
    float energy = 0.5 * speed * speed;
    float iTA = clampPhi(pot.x, G.wwB.x, G.wwB.y);
    float iWC = clampPhi(pot.y * CELL_H, G.wwB.z, G.wwB.w);
    float iK = clampPhi(energy, G.wwA.z, G.wwA.w);
    float amount = iK * (G.wwA.x * iTA + G.wwA.y * iWC) * DT;
    amount *= max(0.0, 1.0 - float(wwCount[cellIndex(c)]) / float(max(G.flags.w, 1)));
    if (amount <= 0.0) {
        return;
    }
    uint seed = hash(id * 1664525u + uint(pc.a.w));
    int count = int(amount) + (rand(seed) < fract(amount) ? 1 : 0);
    count = min(count, int(G.wwD.w));
    for (int k = 0; k < count; k++) {
        uint o = atomicAdd(counters[pc.b.x], 1u);
        if (o >= uint(G.caps.y)) {
            return;
        }
        vec3 offset = randInSphere(seed) * 0.6;
        float life = mix(G.wwC.x, G.wwC.y, rand(seed));
        vec3 jitter = randInSphere(seed) * 0.15 * length(v);
        wwDst[o] = Particle(vec4(x + offset, life), vec4(v + jitter, 1.0));
    }
}

void main() {
    uint i = GID_U;
    if (i >= counters[pc.a.x]) {
        return;
    }
    Particle p = src[i];
    if (p.pos.w < 0.0) {
        return;
    }
    vec3 x = p.pos.xyz;
    vec3 v = p.vel.xyz;
    float tag = p.pos.w;
    bool sand = isSand();
    float maxSpeed = G.simB.x;
    bool gridded = inInnerBox(x);
    vec3 dx;
    if (gridded) {
        vec3 uNew = sampleVel(x);
        vec3 uOld = sampleVelOld(x);
        v = mix(uNew, v + (uNew - uOld), G.simA.x);
        dx = DT * sampleVel(x + 0.5 * DT * uNew);
        if (sand && length(uNew) < G.matB.x && length(v) < G.matB.x) {
            v = vec3(0.0);
            dx = vec3(0.0);
        }
        if (!sand && !waterFilm(x, v, dx, tag)) {
            return;
        }
    } else {
        v += G.gravityDt.xyz * DT;
        dx = DT * v;
    }
    float s = length(v);
    if (s > maxSpeed) {
        v *= maxSpeed / s;
    }
    float dl = length(dx);
    float maxStep = maxSpeed * DT;
    if (dl > maxStep) {
        dx *= maxStep / dl;
    }
    vec3 xn = collideStatic(x, x + dx, v);
    xn = collideEntities(xn, v);
    if (any(isnan(xn)) || any(isinf(xn)) || any(isnan(v))) {
        return;
    }

    float killMargin = G.killInfo.y;
    if (any(lessThan(xn, vec3(-killMargin))) || any(greaterThanEqual(xn, vec3(NX, NY, NZ) + killMargin)) || xn.y < G.killInfo.x) {
        return;
    }
    uint groupTotal = subgroupAdd(1u);
    uint prefix = subgroupExclusiveAdd(1u);
    float groupMax = subgroupMax(length(v));
    uint base = 0u;
    if (subgroupElect()) {
        base = atomicAdd(counters[pc.a.y], groupTotal);
        atomicMax(counters[6], floatBitsToUint(groupMax));
    }
    uint o = subgroupBroadcastFirst(base) + prefix;
    if (o >= uint(G.caps.x)) {
        return;
    }
    dst[o] = Particle(vec4(xn, tag), vec4(v, sand ? p.vel.w : 0.0));
    uvec3 cell = uvec3(ivec3(floor(xn)) + AABB_BIAS);
    uvec3 lo = uvec3(subgroupMin(cell.x), subgroupMin(cell.y), subgroupMin(cell.z));
    uvec3 hi = uvec3(subgroupMax(cell.x), subgroupMax(cell.y), subgroupMax(cell.z));
    if (subgroupElect()) {
        atomicMin(counters[8], lo.x);
        atomicMin(counters[9], lo.y);
        atomicMin(counters[10], lo.z);
        atomicMax(counters[11], hi.x);
        atomicMax(counters[12], hi.y);
        atomicMax(counters[13], hi.z);
    }
    if (pc.b.y != 0 && gridded) {
        emitWhitewater(i, xn, v);
    }
}
