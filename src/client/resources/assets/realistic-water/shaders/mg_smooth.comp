#version 450
#include "common.glsl"
#include "mg_common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer MgFlags { uint mgFlags[]; };
layout(std430, binding = 2) readonly buffer B { float b[]; };
layout(std430, binding = 3) buffer X { float x[]; };

void main() {
    int t = int(GID_U);
    int l = pc.misc.z;
    if (t >= lvlBoxCount(pc.dims, l)) {
        return;
    }
    ivec3 c = lvlBoxCell(t, pc.dims, l);
    int i = lvlIndex(c, pc.dims);
    bool init = pc.misc.y != 0;
    if (mgFlags[i] != CELL_FLUID) {
        if (init) {
            x[i] = 0.0;
        }
        return;
    }
    if (((c.x + c.y + c.z) & 1) != pc.misc.x) {
        return;
    }
    float s = 0.0;
    float n = 0.0;
    for (int k = 0; k < 6; k++) {
        ivec3 nb = c + MG_NB[k];
        if (!lvlActive(nb, pc.dims, l)) {
            n += 1.0;
            continue;
        }
        int j = lvlIndex(nb, pc.dims);
        uint ty = mgFlags[j];
        if (ty == CELL_SOLID) {
            continue;
        }
        n += 1.0;
        if (ty == CELL_FLUID && !init) {
            s += x[j];
        }
    }
    if (n > 0.0) {
        x[i] = (b[i] + s) / n;
    }
}
