#version 450
#include "common.glsl"
layout(local_size_x = 1) in;
layout(std430, binding = 1) buffer Counters { uint counters[]; };
layout(std430, binding = 2) writeonly buffer Args { uint args[]; };
layout(push_constant) uniform PC { ivec4 a; ivec4 b; } pc;

void main() {
    uint nf = min(counters[pc.a.x], uint(G.caps.x));
    uint nw = min(counters[pc.a.y], uint(G.caps.y));
    uint nd = min(counters[4], uint(G.caps.x));
    counters[pc.a.x] = nf;
    counters[pc.a.y] = nw;
    args[0] = max((nf + 255u) / 256u, 1u); args[1] = 1u; args[2] = 1u; args[3] = 0u;
    args[4] = max((nw + 255u) / 256u, 1u); args[5] = 1u; args[6] = 1u; args[7] = 0u;
    args[8] = 6u; args[9] = nd; args[10] = 0u; args[11] = 0u;
    args[12] = 6u; args[13] = nf; args[14] = 0u; args[15] = 0u;
    args[16] = 6u; args[17] = nw; args[18] = 0u; args[19] = 0u;
}
