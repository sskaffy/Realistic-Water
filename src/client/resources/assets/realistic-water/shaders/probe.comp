#version 450
#include "common.glsl"
layout(local_size_x = 1) in;
layout(std430, binding = 1) readonly buffer Dens { int cellDens[]; };
layout(std430, binding = 2) readonly buffer Flags { uint cellFlags[]; };
layout(std430, binding = 3) buffer ViewState { uint viewBits[]; };

float densityAt(vec3 p) {
    ivec3 c = ivec3(floor(p));
    if (!inBox(c)) {
        return 0.0;
    }
    int i = cellIndex(c);
    if ((cellFlags[i] & 0xFFu) == CELL_SOLID) {
        return -1.0;
    }
    return float(cellDens[i]) / FP_SCALE / G.simA.y;
}

void main() {
    vec3 cam = G.camGrid.xyz;
    float r = 0.6 * G.camGrid.w;
    vec3 offsets[5] = vec3[](vec3(0.0), vec3(r, 0.0, 0.0), vec3(-r, 0.0, 0.0), vec3(0.0, 0.0, r), vec3(0.0, 0.0, -r));
    float sum = 0.0;
    float n = 0.0;
    for (int k = 0; k < 5; k++) {
        float d = densityAt(cam + offsets[k]);
        if (d >= 0.0) {
            sum += min(d, 1.0);
            n += 1.0;
        }
    }
    float density = n > 0.0 ? sum / n : 0.0;
    atomicMax(viewBits[0], floatBitsToUint(smoothstep(0.35, 0.6, density)));
    atomicMax(viewBits[1], floatBitsToUint(density));
}
