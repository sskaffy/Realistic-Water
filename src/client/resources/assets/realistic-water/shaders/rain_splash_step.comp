#version 450
#include "rain_common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) buffer Splashes { Drop splashes[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(R.counts.y)) {
        return;
    }
    Drop s = splashes[i];
    if (s.pos.w < 0.0) {
        return;
    }
    s.pos.xyz += R.shift.xyz;
    float dt = R.shift.w;
    s.pos.w += dt;
    if (s.pos.w > abs(s.vel.w)) {
        s.pos.w = -1.0;
    } else if (s.vel.w > 0.0) {
        s.vel.y -= 22.0 * dt;
        s.pos.xyz += s.vel.xyz * dt;
    }
    splashes[i] = s;
}
