#version 450
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer Partials { float partials[]; };
layout(std430, binding = 2) buffer Scalars { float scalars[]; };
layout(push_constant) uniform PC { ivec4 a; ivec4 b; } pc;

shared float sdata[256];

void main() {
    uint t = gl_LocalInvocationID.x;
    float s = 0.0;
    for (int i = int(t); i < pc.a.x; i += 256) {
        s += partials[i];
    }
    sdata[t] = s;
    barrier();
    for (uint k = 128u; k > 0u; k >>= 1) {
        if (t < k) {
            sdata[t] += sdata[t + k];
        }
        barrier();
    }
    if (t == 0u) {
        scalars[pc.a.y] = sdata[0];
    }
}
