#version 450
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer Flags { uint cellFlags[]; };
layout(std430, binding = 2) writeonly buffer MgFlags { uint mgFlags[]; };

void main() {
    int t = int(GID_U);
    if (t < G.boxMin.w) {
        int i = cellIndex(boxCell(t));
        mgFlags[i] = cellFlags[i] & 0xFFu;
    }
}
