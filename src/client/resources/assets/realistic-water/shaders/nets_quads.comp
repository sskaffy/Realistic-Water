#version 450
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer Dens { float dens[]; };
layout(std430, binding = 2) readonly buffer VertexId { uint vertexId[]; };
layout(std430, binding = 3) writeonly buffer Quads { uvec4 quads[]; };
layout(std430, binding = 4) buffer MeshCounters { uint meshCounters[]; };
layout(push_constant) uniform PC { ivec4 a; ivec4 b; } pc;

float densAt(ivec3 p) {
    return inFine(p) ? dens[fineIndex(p)] : 0.0;
}

uint cubeVertex(ivec3 c, ivec3 dim) {
    if (any(lessThan(c, G.fineBoxMin.xyz - 1)) || any(greaterThan(c, G.fineBoxMax.xyz - 1))) {
        return 0xFFFFFFFFu;
    }
    ivec3 q = c + 1;
    return vertexId[q.x + dim.x * (q.y + dim.y * q.z)];
}

void main() {
    ivec3 dim = G.fine.xyz + 1;
    int t = int(GID_U);
    if (t >= G.fineBoxMax.w) {
        return;
    }
    ivec3 bd = G.fineBoxMax.xyz - G.fineBoxMin.xyz + 1;
    ivec3 p = G.fineBoxMin.xyz - 1 + ivec3(t % bd.x, (t / bd.x) % bd.y, t / (bd.x * bd.y));
    float iso = G.surf.x;
    bool inside = densAt(p) > iso;
    for (int axis = 0; axis < 3; axis++) {
        ivec3 ea = ivec3(axis == 0 ? 1 : 0, axis == 1 ? 1 : 0, axis == 2 ? 1 : 0);
        if ((densAt(p + ea) > iso) == inside) {
            continue;
        }
        ivec3 eb = ivec3(axis == 1 ? 1 : 0, axis == 2 ? 1 : 0, axis == 0 ? 1 : 0);
        ivec3 ec = ivec3(axis == 2 ? 1 : 0, axis == 0 ? 1 : 0, axis == 1 ? 1 : 0);
        uint v0 = cubeVertex(p - eb - ec, dim);
        uint v1 = cubeVertex(p - ec, dim);
        uint v2 = cubeVertex(p, dim);
        uint v3 = cubeVertex(p - eb, dim);
        if (v0 == 0xFFFFFFFFu || v1 == 0xFFFFFFFFu || v2 == 0xFFFFFFFFu || v3 == 0xFFFFFFFFu) {
            continue;
        }
        uint q = atomicAdd(meshCounters[1], 1u);
        if (q >= uint(pc.a.y)) {
            return;
        }
        quads[q] = uvec4(v0, v1, v2, v3);
    }
}
