#version 450
#include "common.glsl"
#include "grain_common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer Parts { Particle parts[]; };
layout(std430, binding = 2) readonly buffer Dens { float dens[]; };
layout(std430, binding = 8) readonly buffer DensHi { float densHi[]; };
#define DENS_AT(i) (uint(i) < SPLIT_FINE ? dens[uint(i)] : densHi[uint(i) - SPLIT_FINE])
layout(std430, binding = 3) writeonly buffer Visible { SurfaceParticle visible[]; };
layout(std430, binding = 4) buffer Args { uint args[]; };
layout(std430, binding = 5) readonly buffer Counters { uint counters[]; };
layout(push_constant) uniform PC { ivec4 a; ivec4 b; } pc;
#define REGION_LIGHT_BINDING 6
#include "region_light.glsl"
#define PACK_SHADOW_BINDING 7
#include "sun_shadow.glsl"

#define ARGS_GRAIN_INSTANCES 21
#define ARGS_GRAIN_FAR_INSTANCES 29

float densAt(ivec3 p) {
    return inFine(p) ? DENS_AT(fineIndex(p)) : 0.0;
}

void main() {
    uint i = GID_U;
    if (i >= counters[pc.a.x]) {
        return;
    }
    Particle p = parts[i];
    if (p.pos.w < 0.0) {
        return;
    }
    float spread = max(p.pos.w, 1.0);
    vec3 rel = G.domainOrigin.xyz + p.pos.xyz * G.domainOrigin.w;
    vec3 center = (G.view * vec4(rel, 1.0)).xyz;
    float dist = -center.z;
    float reachOut = G.matD.z * spread * G.domainOrigin.w + G.matB.w * 4.0;
    if (pc.a.y != 0) {
        if (dist < G.surf.z - reachOut) {
            return;
        }
        float w = max(dist, 0.0);
        if (abs(center.x) * G.proj[0][0] > w + reachOut * G.proj[0][0] || abs(center.y) * G.proj[1][1] > w + reachOut * G.proj[1][1]) {
            return;
        }
    }
    int sub = G.fine.w;
    ivec3 fp = ivec3(floor(p.pos.xyz * float(sub)));
    int reach = 2 * sub;
    float iso = G.surf.x;
    float deepest = min(min(densAt(fp - ivec3(reach, 0, 0)), densAt(fp + ivec3(reach, 0, 0))),
        min(min(densAt(fp - ivec3(0, reach, 0)), densAt(fp + ivec3(0, reach, 0))),
            min(densAt(fp - ivec3(0, 0, reach)), densAt(fp + ivec3(0, 0, reach)))));
    if (deepest > iso) {
        return;
    }
    vec3 grad = vec3(densAt(fp - ivec3(sub, 0, 0)) - densAt(fp + ivec3(sub, 0, 0)),
        densAt(fp - ivec3(0, sub, 0)) - densAt(fp + ivec3(0, sub, 0)),
        densAt(fp - ivec3(0, 0, sub)) - densAt(fp + ivec3(0, 0, sub)));
    vec3 n = dot(grad, grad) > 1e-4 ? normalize(grad) : vec3(0.0, 1.0, 0.0);
    n = normalize(vec3(n.x, max(n.y, 0.0) + 0.05, n.z));
    float shade = mix(1.0, 0.82, smoothstep(iso, 1.0, densAt(fp)));

    float lod = 0.0;
    if (pc.a.y != 0) {
        float pixelR = G.matB.w * G.proj[1][1] * 0.5 * G.screen.y / max(dist, 1e-3);
        float minPx = max(G.matD.x, 0.05);
        uint ls = floatBitsToUint(p.vel.w) * 0x9E3779B1u + 3u;
        lod = clamp(floor(log2(minPx / max(pixelR, 1e-6)) + rand(ls)), 0.0, 2.0);
    }

    uint o;
    if (lod < 0.5) {
        o = atomicAdd(args[ARGS_GRAIN_INSTANCES], 1u);
    } else {
        o = uint(G.caps.x) - 1u - atomicAdd(args[ARGS_GRAIN_FAR_INSTANCES], 1u);
    }
    visible[o] = SurfaceParticle(vec4(p.pos.xyz, spread), vec4(n, shade), vec4(p.vel.w, sunShadowFactor(p.pos.xyz), lod, 0.0));
}
