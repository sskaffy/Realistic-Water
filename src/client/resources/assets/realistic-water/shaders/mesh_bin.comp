#version 450
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer Parts { Particle parts[]; };
layout(std430, binding = 5) readonly buffer PartsHi { Particle partsHi[]; };
#define PARTS_AT(i) (uint(i) < SPLIT_PART ? parts[uint(i)] : partsHi[uint(i) - SPLIT_PART])
layout(std430, binding = 2) buffer Counters { uint counters[]; };
layout(std430, binding = 3) buffer Cursor { uint cursor[]; };
layout(std430, binding = 4) writeonly buffer Sorted { Particle sorted[]; };
layout(std430, binding = 6) writeonly buffer SortedHi { Particle sortedHi[]; };
#define SORTED_AT(i) (uint(i) < SPLIT_PART ? sorted[uint(i)] : sortedHi[uint(i) - SPLIT_PART])
#define SORTED_SET(i, v) { uint s_sorted = uint(i); if (s_sorted < SPLIT_PART) { sorted[s_sorted] = (v); } else { sortedHi[s_sorted - SPLIT_PART] = (v); } }
layout(push_constant) uniform PC { ivec4 a; ivec4 b; } pc;

void main() {
    uint i = GID_U;
    if (i >= counters[pc.a.x]) {
        return;
    }
    Particle p = PARTS_AT(i);
    if (p.pos.w < 0.0) {
        return;
    }
    ivec3 c = ivec3(floor(p.pos.xyz));
    if (inBox(c)) {
        SORTED_SET(atomicAdd(cursor[sortKey(c)], 1u), p);
    } else if (pc.a.y >= 0) {
        uint o = atomicAdd(counters[pc.a.y], 1u);
        if (o < uint(G.caps.x)) {
            SORTED_SET(o, p);
        }
    }
}
