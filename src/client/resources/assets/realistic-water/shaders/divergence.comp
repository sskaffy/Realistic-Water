#version 450
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer Vel { float vel[]; };
layout(std430, binding = 2) readonly buffer Flags { uint cellFlags[]; };
layout(std430, binding = 3) readonly buffer Dens { int cellDens[]; };
layout(std430, binding = 4) writeonly buffer Div { float div[]; };
layout(std430, binding = 5) buffer Pressure { float pressure[]; };

void main() {
    int bt = int(GID_U);
    if (bt >= G.boxMin.w) {
        return;
    }
    ivec3 c = boxCell(bt);
    int i = cellIndex(c);
    if ((cellFlags[i] & 0xFFu) != CELL_FLUID) {
        div[i] = 0.0;
        pressure[i] = 0.0;
        return;
    }
    float d = vel[faceIndex(0, c + ivec3(1, 0, 0))] - vel[faceIndex(0, c)]
            + vel[faceIndex(1, c + ivec3(0, 1, 0))] - vel[faceIndex(1, c)]
            + vel[faceIndex(2, c + ivec3(0, 0, 1))] - vel[faceIndex(2, c)];
    float rho = float(cellDens[i]) / FP_SCALE / G.simA.y;
    float target = G.simA.z * max(rho - 1.0, 0.0);
    div[i] = target - d;
}
