#version 450
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer Dens { float dens[]; };
layout(std430, binding = 2) writeonly buffer VertexId { uint vertexId[]; };
layout(std430, binding = 3) writeonly buffer Verts { vec4 verts[]; };
layout(std430, binding = 4) buffer MeshCounters { uint meshCounters[]; };
layout(std430, binding = 5) readonly buffer Static { uint staticSolid[]; };
layout(push_constant) uniform PC { ivec4 a; ivec4 b; } pc;

float densAt(ivec3 p) {
    return inFine(p) ? dens[fineIndex(p)] : 0.0;
}

float densTri(vec3 p) {
    ivec3 b = ivec3(floor(p));
    vec3 f = p - vec3(b);
    float r = 0.0;
    for (int k = 0; k < 8; k++) {
        ivec3 o = ivec3(k & 1, (k >> 1) & 1, (k >> 2) & 1);
        vec3 w = mix(1.0 - f, f, vec3(o));
        r += w.x * w.y * w.z * densAt(b + o);
    }
    return r;
}

bool solidNear(vec3 simPos) {
    for (int k = 0; k < 7; k++) {
        vec3 o = k == 0 ? vec3(0.0) : vec3(k == 1 ? 0.6 : (k == 2 ? -0.6 : 0.0), k == 3 ? 0.6 : (k == 4 ? -0.6 : 0.0), k == 5 ? 0.6 : (k == 6 ? -0.6 : 0.0));
        ivec3 c = ivec3(floor(simPos + o));
        if (inGrid(c) && staticSolid[cellIndex(c)] != 0u) {
            return true;
        }
    }
    return false;
}

const ivec2 EDGES[12] = ivec2[](ivec2(0, 1), ivec2(2, 3), ivec2(4, 5), ivec2(6, 7), ivec2(0, 2), ivec2(1, 3),
                                ivec2(4, 6), ivec2(5, 7), ivec2(0, 4), ivec2(1, 5), ivec2(2, 6), ivec2(3, 7));

void main() {
    ivec3 dim = G.fine.xyz + 1;
    int t = int(GID_U);
    if (t >= G.fineBoxMax.w) {
        return;
    }
    ivec3 bd = G.fineBoxMax.xyz - G.fineBoxMin.xyz + 1;
    ivec3 c = G.fineBoxMin.xyz - 1 + ivec3(t % bd.x, (t / bd.x) % bd.y, t / (bd.x * bd.y));
    int id = (c.x + 1) + dim.x * ((c.y + 1) + dim.y * (c.z + 1));
    float iso = G.surf.x;
    float d[8];
    uint mask = 0u;
    for (int k = 0; k < 8; k++) {
        d[k] = densAt(c + ivec3(k & 1, (k >> 1) & 1, (k >> 2) & 1));
        if (d[k] > iso) {
            mask |= 1u << k;
        }
    }
    if (mask == 0u || mask == 255u) {
        vertexId[id] = 0xFFFFFFFFu;
        return;
    }
    vec3 sum = vec3(0.0);
    float n = 0.0;
    for (int e = 0; e < 12; e++) {
        int a = EDGES[e].x;
        int b = EDGES[e].y;
        if (((mask >> a) & 1u) != ((mask >> b) & 1u)) {
            float t = clamp((iso - d[a]) / (d[b] - d[a]), 0.0, 1.0);
            vec3 pa = vec3(a & 1, (a >> 1) & 1, (a >> 2) & 1);
            vec3 pb = vec3(b & 1, (b >> 1) & 1, (b >> 2) & 1);
            sum += mix(pa, pb, t);
            n += 1.0;
        }
    }
    vec3 local = sum / n;
    vec3 at = vec3(c) + local;
    const float E = 0.75;
    vec3 grad = vec3(
        densTri(at + vec3(E, 0.0, 0.0)) - densTri(at - vec3(E, 0.0, 0.0)),
        densTri(at + vec3(0.0, E, 0.0)) - densTri(at - vec3(0.0, E, 0.0)),
        densTri(at + vec3(0.0, 0.0, E)) - densTri(at - vec3(0.0, 0.0, E)));
    if (dot(grad, grad) < 1e-10) {
        grad = vec3(
            (d[1] + d[3] + d[5] + d[7]) - (d[0] + d[2] + d[4] + d[6]),
            (d[2] + d[3] + d[6] + d[7]) - (d[0] + d[1] + d[4] + d[5]),
            (d[4] + d[5] + d[6] + d[7]) - (d[0] + d[1] + d[2] + d[3]));
    }
    vec3 normal = dot(grad, grad) > 1e-12 ? -normalize(grad) : vec3(0.0, 1.0, 0.0);

    uint vi = atomicAdd(meshCounters[0], 1u);
    if (vi >= uint(pc.a.x)) {
        vertexId[id] = 0xFFFFFFFFu;
        return;
    }
    vec3 simPos = (vec3(c) + local + 0.5) / float(G.fine.w);
    verts[vi] = vec4(simPos, uintBitsToFloat(packNormal(normal, solidNear(simPos))));
    vertexId[id] = vi;
}
