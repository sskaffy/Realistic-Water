#version 450
#include "rain_common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) buffer Drops { Drop drops[]; };
layout(std430, binding = 2) buffer Splashes { Drop splashes[]; };
layout(std430, binding = 3) buffer Cursor { uint cursor[]; };
layout(std430, binding = 4) readonly buffer Columns { ivec4 cols[]; };
layout(std430, binding = 5) buffer Events { uvec4 eventCount; vec4 events[]; };

#ifdef TREES
uint hash(uint x) {
    return rhash(x);
}
float rand(inout uint state) {
    return rrand(state);
}
#define TREE_PARAMS_BINDING 6
#define TREE_BLOCKS_BINDING 7
#include "tree_common.glsl"
layout(std430, binding = 8) readonly buffer TreeTable { uint ttable[]; };
layout(std430, binding = 9) readonly buffer TreeMotions { TreeMotion tmotion[]; };

int treeLookup(ivec3 p) {
    uint key = uint(p.x & 2047) | (uint(p.z & 2047) << 11) | (uint(p.y & 1023) << 22);
    uint mask = uint(T.sim.x);
    uint h = rhash(key) & mask;
    for (int probe = 0; probe < 64; probe++) {
        uint k = ttable[h * 2u];
        if (k == key) {
            return int(ttable[h * 2u + 1u]);
        }
        if (k == 0xFFFFFFFFu) {
            return -1;
        }
        h = (h + 1u) & mask;
    }
    return -1;
}

float hitLeaves(int slot, vec3 p0, vec3 p1, vec3 camTree, out vec3 hit) {
    TreeBlock b = tblocks[slot];
    if (!treeActive(b)) {
        return 2.0;
    }
    vec3 corner = vec3(b.pos.xyz - T.cam.xyz);
    int count = treeLeafCount(length(corner + 0.5 - camTree));
    TreeMotion m = tmotion[slot];
    vec3 a = p0 - corner;
    vec3 d = p1 - p0;
    float best = 2.0;
    for (int i = 0; i < count; i++) {
        TreeLeaf l = treeLeaf(b, i, count);
        treeLeafMove(l, m);
        float denom = dot(l.normal, d);
        if (abs(denom) < 1e-6) {
            continue;
        }
        float t = dot(l.normal, l.centre - a) / denom;
        if (t < 0.0 || t > 1.0 || t >= best) {
            continue;
        }
        vec3 q = a + d * t - l.centre;
        float u = dot(q, l.across) / (l.size * 0.38);
        float v = dot(q, l.along) / (l.size * 0.5);
        if (u * u + v * v <= 1.0) {
            best = t;
            hit = corner + l.centre;
        }
    }
    return best;
}
#endif

void event(vec3 at, float kind) {
    uint e = atomicAdd(eventCount.x, 1u);
    if (e < uint(R.extra.x)) {
        events[e] = vec4(at, kind);
    }
}

void respawn(inout Drop d, inout uint seed, bool top) {
    float radius = R.fall.y;
    vec2 xz = R.cam.xz + (vec2(rrand(seed), rrand(seed)) * 2.0 - 1.0) * radius;
    float y = top ? R.cam.y + R.fall.z * (0.8 + 0.4 * rrand(seed))
        : R.cam.y - R.fall.w + rrand(seed) * (R.fall.z + R.fall.w);
    float speed = R.fall.x * (0.85 + 0.3 * rrand(seed));
    d.pos = vec4(xz.x, y, xz.y, 1.0);
    d.vel = vec4(R.wind.x, -speed, R.wind.z, rrand(seed));
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(R.counts.x)) {
        return;
    }
    uint seed = rhash(i * 747796405u + uint(R.counts.z) * 2891336453u);
    Drop d = drops[i];
    d.pos.xyz += R.shift.xyz;
    if (d.pos.w <= 0.0) {
        respawn(d, seed, false);
    }
    if (i >= uint(R.counts.w)) {
        d.pos.y = R.cam.y + R.fall.z;
        drops[i] = d;
        return;
    }
    float radius = R.fall.y;
    vec2 rel = d.pos.xz - R.cam.xz;
    if (abs(rel.x) > radius) {
        d.pos.x -= sign(rel.x) * 2.0 * radius;
    }
    if (abs(rel.y) > radius) {
        d.pos.z -= sign(rel.y) * 2.0 * radius;
    }
    d.pos.xyz += d.vel.xyz * R.shift.w;

    ivec2 c = ivec2(floor(d.pos.xz + R.grid.yz));
    ivec4 col = cols[columnIndex(c)];
    bool known = col.x == c.x && col.y == c.y;
    int flags = col.w & 0xFF;
    float top = intBitsToFloat(col.z);
#ifdef TREES
    if (known && (flags & COL_LEAVES) != 0 && (flags & COL_RAINS) != 0 && d.pos.y <= top && T.cam.w > 0) {
        vec3 toTree = T.rain.xyz;
        vec3 p1 = d.pos.xyz + toTree;
        vec3 p0 = p1 - d.vel.xyz * R.shift.w;
        ivec3 canopyTop = T.cam.xyz + ivec3(floor(vec3(p1.x, top - 0.5 + toTree.y, p1.z)));
        if (treeLookup(canopyTop) >= 0) {
            float ground = top - float((col.w >> 16) & 255) / 8.0;
            vec3 camTree = R.cam.xyz + toTree;
            float best = 2.0;
            vec3 hit = vec3(0.0);
            int y0 = int(floor(min(p0.y, top + toTree.y - 1e-3)));
            int y1 = int(floor(p1.y));
            for (int y = y0; y >= y1 && y >= y0 - 3; y--) {
                int slot = treeLookup(T.cam.xyz + ivec3(int(floor(p1.x)), y, int(floor(p1.z))));
                if (slot >= 0) {
                    vec3 h;
                    float t = hitLeaves(slot, p0, p1, camTree, h);
                    if (t < best) {
                        best = t;
                        hit = h;
                    }
                }
            }
            if (best <= 1.0) {
                vec3 at = p0 + (p1 - p0) * best - toTree;
                event(hit - toTree, EVENT_LEAF);
                int droplets = int(R.splash.x * 0.5 + rrand(seed));
                uint base = droplets > 0 ? atomicAdd(cursor[0], uint(droplets)) : 0u;
                for (int k = 0; k < droplets; k++) {
                    float a = rrand(seed) * 6.2831853;
                    float out_ = R.splash.y * (0.15 + 0.35 * rrand(seed));
                    Drop s;
                    s.pos = vec4(at, 0.0);
                    s.vel = vec4(cos(a) * out_, R.splash.y * (0.2 + 0.5 * rrand(seed)), sin(a) * out_, R.splash.z * (0.4 + 0.6 * rrand(seed)));
                    splashes[(base + uint(k)) % uint(R.counts.y)] = s;
                }
                respawn(d, seed, true);
                drops[i] = d;
                return;
            }
            if (d.pos.y > ground) {
                drops[i] = d;
                return;
            }
            top = ground;
            flags &= ~COL_LEAVES;
        }
    }
#endif
    if (known && (flags & COL_RAINS) == 0) {
        respawn(d, seed, true);
    } else if (known && d.pos.y <= top) {
        bool water = (flags & COL_WATER) != 0;
        bool lava = (flags & COL_LAVA) != 0;
        if (water || lava) {
            event(vec3(d.pos.x, top, d.pos.z), lava ? EVENT_LAVA : EVENT_WATER);
        } else if ((flags & COL_LEAVES) != 0) {
            event(vec3(d.pos.x, top, d.pos.z), EVENT_LEAF);
        }
        int droplets = lava ? 0 : water ? int(rrand(seed) < 0.4) : int(R.splash.x + rrand(seed));
        int ripple = water ? 1 : 0;
        uint total = uint(droplets + ripple);
        uint base = total > 0u ? atomicAdd(cursor[0], total) : 0u;
        uint cap = uint(R.counts.y);
        for (int k = 0; k < droplets; k++) {
            float a = rrand(seed) * 6.2831853;
            float out_ = R.splash.y * (0.25 + 0.55 * rrand(seed));
            Drop s;
            s.pos = vec4(d.pos.x, top + 0.02, d.pos.z, 0.0);
            s.vel = vec4(cos(a) * out_, R.splash.y * (0.6 + 0.9 * rrand(seed)), sin(a) * out_, R.splash.z * (0.6 + 0.8 * rrand(seed)));
            splashes[(base + uint(k)) % cap] = s;
        }
        if (ripple == 1) {
            Drop s;
            s.pos = vec4(d.pos.x, top + 0.004, d.pos.z, 0.0);
            s.vel = vec4(0.0, 0.0, 0.0, -R.splash.w * (0.7 + 0.6 * rrand(seed)));
            splashes[(base + uint(droplets)) % cap] = s;
        }
        respawn(d, seed, true);
    } else if (d.pos.y < R.cam.y - R.fall.w) {
        respawn(d, seed, true);
    }
    drops[i] = d;
}
