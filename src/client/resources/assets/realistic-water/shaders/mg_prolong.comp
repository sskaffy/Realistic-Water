#version 450
#include "common.glsl"
#include "mg_common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer MgFlags { uint mgFlags[]; };
layout(std430, binding = 2) buffer FineX { float fineX[]; };
layout(std430, binding = 3) readonly buffer CoarseX { float coarseX[]; };

void main() {
    int t = int(GID_U);
    if (t >= lvlBoxCount(pc.dims, pc.misc.z)) {
        return;
    }
    ivec3 f = lvlBoxCell(t, pc.dims, pc.misc.z);
    int fi = lvlIndex(f, pc.dims);
    if (mgFlags[fi] != CELL_FLUID) {
        return;
    }
    fineX[fi] += coarseX[lvlIndex(f / 2, pc.cdims)];
}
