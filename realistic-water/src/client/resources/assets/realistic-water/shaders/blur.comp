#version 450
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer SrcInt { int srcInt[]; };
layout(std430, binding = 2) readonly buffer SrcFloat { float srcFloat[]; };
layout(std430, binding = 3) writeonly buffer Dst { float dst[]; };
layout(push_constant) uniform PC { ivec4 a; ivec4 b; } pc;

float load(ivec3 p) {
    if (!inFine(p)) {
        return 0.0;
    }
    int i = fineIndex(p);
    return pc.a.y != 0 ? float(srcInt[i]) / (4096.0 * G.surf.y) : srcFloat[i];
}

void main() {
    int t = int(GID_U);
    if (t >= G.fineBoxMin.w) {
        return;
    }
    ivec3 bd = G.fineBoxMax.xyz - G.fineBoxMin.xyz;
    ivec3 p = G.fineBoxMin.xyz + ivec3(t % bd.x, (t / bd.x) % bd.y, t / (bd.x * bd.y));
    int i = fineIndex(p);
    ivec3 e = ivec3(pc.a.x == 0 ? 1 : 0, pc.a.x == 1 ? 1 : 0, pc.a.x == 2 ? 1 : 0);
    float inv2s2 = 0.5 / max(G.waterA.w * G.waterA.w, 1e-4);
    float w1 = exp(-inv2s2);
    float w2 = exp(-4.0 * inv2s2);
    float v = (w2 * (load(p - 2 * e) + load(p + 2 * e)) + w1 * (load(p - e) + load(p + e)) + load(p))
        / (1.0 + 2.0 * w1 + 2.0 * w2);
    if (pc.a.z != 0 && G.flags.z != 0) {
        float S = float(G.fine.w);
        vec3 sp = (vec3(p) + 0.5) / S;
        vec3 lo = entMin(0) - 0.5;
        vec3 hi = entMax(0) + 0.5;
        if (all(greaterThan(sp, lo)) && all(lessThan(sp, hi))) {
            float side = load(ivec3(floor(vec3(lo.x - 1.0, sp.y, sp.z) * S)))
                + load(ivec3(floor(vec3(hi.x + 1.0, sp.y, sp.z) * S)))
                + load(ivec3(floor(vec3(sp.x, sp.y, lo.z - 1.0) * S)))
                + load(ivec3(floor(vec3(sp.x, sp.y, hi.z + 1.0) * S)));
            v = max(v, side * 0.25);
        }
    }
    dst[i] = v;
}
