#version 450
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) buffer Vel { float vel[]; };
layout(std430, binding = 2) readonly buffer ValidIn { uint validIn[]; };
layout(std430, binding = 3) writeonly buffer ValidOut { uint validOut[]; };

const ivec3 NB[6] = ivec3[](ivec3(1, 0, 0), ivec3(-1, 0, 0), ivec3(0, 1, 0), ivec3(0, -1, 0), ivec3(0, 0, 1), ivec3(0, 0, -1));

void main() {
    int comp;
    ivec3 f;
    if (!boxFace(int(GID_U), comp, f)) {
        return;
    }
    int i = faceIndex(comp, f);
    if (validIn[i] != 0u) {
        validOut[i] = 1u;
        return;
    }
    float s = 0.0;
    float n = 0.0;
    for (int k = 0; k < 6; k++) {
        ivec3 nf = f + NB[k];
        if (!faceInBox(comp, nf)) {
            continue;
        }
        int j = faceIndex(comp, nf);
        if (validIn[j] != 0u) {
            s += vel[j];
            n += 1.0;
        }
    }
    if (n > 0.0) {
        vel[i] = s / n;
        validOut[i] = 1u;
    } else {
        validOut[i] = 0u;
    }
}
