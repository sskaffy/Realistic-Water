#version 450
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer Static { uint staticSolid[]; };
layout(std430, binding = 2) readonly buffer Count { int cellCount[]; };
layout(std430, binding = 3) writeonly buffer Flags { uint cellFlags[]; };

void main() {
    int bt = int(GID_U);
    if (bt >= G.boxMin.w) {
        return;
    }
    ivec3 c = boxCell(bt);
    int i = cellIndex(c);
    uint t;
    if (staticSolid[i] != 0u) {
        t = CELL_SOLID;
    } else {
        int e = entityAt(vec3(c) + 0.5);
        if (e >= 0) {
            t = CELL_SOLID | (uint(e + 1) << 8);
        } else {
            t = cellCount[i] > 0 ? CELL_FLUID : CELL_AIR;
        }
    }
    cellFlags[i] = t;
}
