#version 450
#include "common.glsl"
#include "mg_common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer MgFlags { uint mgFlags[]; };
layout(std430, binding = 2) readonly buffer P { float p[]; };
layout(std430, binding = 3) writeonly buffer Q { float q[]; };
layout(std430, binding = 4) writeonly buffer Partials { float partials[]; };

#define X_OF(j) p[j]
#include "mg_ops.glsl"

shared float sdata[256];

void main() {
    int t = int(GID_U);
    float v = 0.0;
    if (t < G.boxMin.w) {
        ivec3 c = boxCell(t);
        int i = cellIndex(c);
        if (mgFlags[i] == CELL_FLUID) {
            float aq = applyA(c, i, pc.dims, 0);
            q[i] = aq;
            v = aq * p[i];
        } else {
            q[i] = 0.0;
        }
    }
    uint lt = gl_LocalInvocationID.x;
    sdata[lt] = v;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1) {
        if (lt < s) {
            sdata[lt] += sdata[lt + s];
        }
        barrier();
    }
    if (lt == 0u) {
        partials[GROUP_ID] = sdata[0];
    }
}
