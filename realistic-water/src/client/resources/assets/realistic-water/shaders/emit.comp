#version 450
#include "common.glsl"
layout(local_size_x = 256) in;

struct Emitter {
    vec4 minp;
    vec4 maxp;
    vec4 vel;
    ivec4 info;
};

layout(std430, binding = 1) readonly buffer Emitters { Emitter em[]; };
layout(std430, binding = 2) writeonly buffer Dst { Particle dst[]; };
layout(std430, binding = 3) buffer Counters { uint counters[]; };
layout(std430, binding = 4) readonly buffer Static { uint staticSolid[]; };
layout(push_constant) uniform PC { ivec4 a; ivec4 b; } pc;

void main() {
    int t = int(GID_U);
    if (t >= pc.a.z) {
        return;
    }
    int lo = 0;
    int hi = pc.a.y - 1;
    while (lo < hi) {
        int mid = (lo + hi + 1) >> 1;
        if (em[mid].info.x <= t) lo = mid; else hi = mid - 1;
    }
    Emitter e = em[lo];
    int local = t - e.info.x;
    ivec3 n = e.info.yzw;
    ivec3 ijk = ivec3(local % n.x, (local / n.x) % n.y, local / (n.x * n.y));
    uint seed = hash(uint(t) * 747796405u + uint(pc.a.w));
    vec3 jitter = vec3(rand(seed), rand(seed), rand(seed));
    vec3 size = (e.maxp.xyz - e.minp.xyz) / vec3(n);
    vec3 p = e.minp.xyz + (vec3(ijk) + 0.2 + 0.6 * jitter) * size;
    ivec3 c = ivec3(floor(p));
    if (!inGrid(c) || staticSolid[cellIndex(c)] != 0u) {
        return;
    }
    uint o = atomicAdd(counters[pc.a.x], 1u);
    if (o >= uint(G.caps.x)) {
        return;
    }
    dst[o] = Particle(vec4(p, 0.0), vec4(e.vel.xyz, 0.0));
}
