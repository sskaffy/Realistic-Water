#version 450
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer Vel { float vel[]; };
layout(std430, binding = 2) readonly buffer Flags { uint cellFlags[]; };
layout(std430, binding = 3) readonly buffer Dens { int cellDens[]; };
layout(std430, binding = 4) writeonly buffer Pot { vec2 potential[]; };

uint typeAt(ivec3 c) {
    return inBox(c) ? (cellFlags[cellIndex(c)] & 0xFFu) : CELL_AIR;
}

vec3 cellVel(ivec3 c) {
    c = clamp(c, G.boxMin.xyz, G.boxMax.xyz - 1);
    return 0.5 * vec3(
        vel[faceIndex(0, c)] + vel[faceIndex(0, c + ivec3(1, 0, 0))],
        vel[faceIndex(1, c)] + vel[faceIndex(1, c + ivec3(0, 1, 0))],
        vel[faceIndex(2, c)] + vel[faceIndex(2, c + ivec3(0, 0, 1))]);
}

float densAt(ivec3 c) {
    if (!inBox(c)) {
        return 0.0;
    }
    uint t = cellFlags[cellIndex(c)] & 0xFFu;
    if (t == CELL_SOLID) {
        return G.simA.y;
    }
    return float(cellDens[cellIndex(c)]) / FP_SCALE;
}

void main() {
    int bt = int(GID_U);
    if (bt >= G.boxMin.w) {
        return;
    }
    ivec3 c = boxCell(bt);
    int i = cellIndex(c);
    if ((cellFlags[i] & 0xFFu) != CELL_FLUID) {
        potential[i] = vec2(0.0);
        return;
    }
    bool nearWall = false;
    for (int k = 0; k < 6; k++) {
        ivec3 nb = c + ivec3(k == 0 ? 1 : (k == 1 ? -1 : 0), k == 2 ? 1 : (k == 3 ? -1 : 0), k == 4 ? 1 : (k == 5 ? -1 : 0));
        if (inBox(nb)) {
            uint f = cellFlags[cellIndex(nb)];
            nearWall = nearWall || ((f & 0xFFu) == CELL_SOLID && (f >> 8) == 0u);
        }
    }
    vec3 dx = (cellVel(c + ivec3(1, 0, 0)) - cellVel(c - ivec3(1, 0, 0))) * 0.5;
    vec3 dy = (cellVel(c + ivec3(0, 1, 0)) - cellVel(c - ivec3(0, 1, 0))) * 0.5;
    vec3 dz = (cellVel(c + ivec3(0, 0, 1)) - cellVel(c - ivec3(0, 0, 1))) * 0.5;
    vec3 curl = vec3(dy.z - dz.y, dz.x - dx.z, dx.y - dy.x);
    float trapped = nearWall ? 0.0 : length(curl);

    bool surface = typeAt(c + ivec3(1, 0, 0)) == CELL_AIR || typeAt(c - ivec3(1, 0, 0)) == CELL_AIR
        || typeAt(c + ivec3(0, 1, 0)) == CELL_AIR || typeAt(c - ivec3(0, 1, 0)) == CELL_AIR
        || typeAt(c + ivec3(0, 0, 1)) == CELL_AIR || typeAt(c - ivec3(0, 0, 1)) == CELL_AIR;
    float crest = 0.0;
    if (surface) {
        vec3 grad = vec3(
            densAt(c + ivec3(1, 0, 0)) - densAt(c - ivec3(1, 0, 0)),
            densAt(c + ivec3(0, 1, 0)) - densAt(c - ivec3(0, 1, 0)),
            densAt(c + ivec3(0, 0, 1)) - densAt(c - ivec3(0, 0, 1)));
        vec3 u = cellVel(c);
        vec3 mean = vec3(0.0);
        float count = 0.0;
        for (int k = 0; k < 6; k++) {
            ivec3 nb = c + ivec3(k == 0 ? 2 : (k == 1 ? -2 : 0), k == 2 ? 2 : (k == 3 ? -2 : 0), k == 4 ? 2 : (k == 5 ? -2 : 0));
            if (typeAt(nb) == CELL_FLUID) {
                mean += cellVel(nb);
                count += 1.0;
            }
        }
        vec3 rel = count > 0.0 ? u - mean / count : vec3(0.0);
        if (dot(grad, grad) > 1e-6) {
            crest = max(dot(rel, -normalize(grad)), 0.0);
        }
    }
    potential[i] = vec2(trapped, crest);
}
