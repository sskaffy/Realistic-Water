#version 450
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) writeonly buffer Accum { int accum[]; };
layout(std430, binding = 2) writeonly buffer Count { int cellCount[]; };
layout(std430, binding = 3) writeonly buffer Dens { int cellDens[]; };
layout(std430, binding = 4) writeonly buffer WwCount { int wwCount[]; };

void main() {
    int t = int(GID_U);
    if (t < G.boxMin.w) {
        int i = cellIndex(boxCell(t));
        cellCount[i] = 0;
        cellDens[i] = 0;
        wwCount[i] = 0;
        return;
    }
    int comp;
    ivec3 f;
    if (boxFace(t - G.boxMin.w, comp, f)) {
        int i = faceIndex(comp, f);
        accum[2 * i] = 0;
        accum[2 * i + 1] = 0;
    }
}
